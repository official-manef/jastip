# =========================
# Titipin — environment
# =========================
# Salin ke `.env` lalu isi. `.env` TIDAK pernah masuk repo (.gitignore).
# Vercel: set nilai yang sama di Project → Settings → Environment Variables.

# --- Akun & titipan (Postgres/Neon) ---
# WAJIB untuk akun produksi. Tanpa ini, /api/akun* balas 503 dan hanya meja
# hitung (perangkat) yang jalan.
DATABASE_URL=

# --- Better Auth ---
# Origin publik situs, mis. https://jastip-ochre.vercel.app
BETTER_AUTH_URL=
# Tanda tangan sesi; hasilkan sekali: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Set "true" untuk mengaktifkan login email/password.
VITE_AUTH_ENABLED=true

# --- Admin ---
# ID akun (bukan email) pemilik tunggal. Ditetapkan operator setelah akun dibuat.
TITIPIN_ADMIN_USER_ID=

# --- Convex (skenario trip) ---
# Deploy key dari Convex Dashboard → Project jastip → Settings → Deploy keys.
# Jangan commit. Dipakai `npx convex deploy` di CI/mesin.
CONVEX_DEPLOY_KEY=
# URL backend Convex (deployment prod), mis. https://impressive-wildcat-570.convex.cloud
PUBLIC_CONVEX_URL=
# Opsional: URL deployment spesifik saat dev (npx convex dev menulisnya).
CONVEX_URL=
