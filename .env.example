# =========================
# Titipin — environment
# =========================
# Salin ke `.env` lalu isi. `.env` TIDAK pernah masuk repo (.gitignore).
# Vercel: set nilai yang sama di Project → Settings → Environment Variables.
# Config manef (token Vercel dll): .manef/config.json (gitignored).

# --- Convex (auth akun + skenario trip) ---
# Deploy key dari Convex Dashboard → Project jastip → Settings → Deploy keys.
# Jangan commit. Dipakai `npx convex deploy` di CI/mesin.
CONVEX_DEPLOY_KEY=
# URL backend Convex (deployment prod), mis. https://impressive-wildcat-570.convex.cloud
# Wajib: dipakai auth (Better Auth) + data akun/titipan/trip.
PUBLIC_CONVEX_URL=
# Opsional: URL HTTP actions (*.convex.site). Diturunkan otomatis dari URL .cloud.
PUBLIC_CONVEX_SITE_URL=

# --- SITE_URL (dibaca fungsi Convex, bukan proses ini) ---
# Set di Convex: npx convex env set SITE_URL https://situs-anda
# Set di Convex: npx convex env set BETTER_AUTH_SECRET $(openssl rand -base64 32)

# --- Admin ---
# ID akun (bukan email) pemilik tunggal. Ditetapkan operator setelah akun dibuat.
TITIPIN_ADMIN_USER_ID=

# --- AI (asisten + function calling) ---
# Semua server-only. Jangan pakai prefix VITE_ (jangan sampai ke browser).
# Key server: dipakai kalau pengguna tidak mengisi key sendiri (BYOK opsional).
AI_API_KEY=
# Base URL penyedia kompatibel OpenAI. Default: https://token.conextlab.ai/v1
AI_API_BASE_URL=
# ID model default. Default: ollama/deepseek-v4.1-flash:cloud (tools=true, vision=false)
AI_MODEL=
# Host yang boleh dikirimi key, dipisah koma. Default: host dari AI_API_BASE_URL.
AI_ALLOWED_HOSTS=

