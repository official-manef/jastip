{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "types": ["$app/types", "node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.svelte",
    "src/**/*.js",
    "server/**/*.ts"
  ],
  "exclude": ["src/service-worker"]
}
